// =====================================================================
// eSoccer Domain Foundation — Fase 1 (ESOCCER INTELLIGENCE V1)
// Fundação de dados para Bet365 eSoccer. Não integra BetsAPI nesta fase.
// Regra central: o jogador (nickname) é a identidade estatística
// permanente; a equipe virtual é apenas o contexto da partida.
// =====================================================================

enum ESoccerPlayerStatus {
  ACTIVE
  INACTIVE
}

enum ESoccerLeagueStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum ESoccerMatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
  UNKNOWN
}

enum ESoccerProvider {
  BETSAPI
  FIXTURE
  CSV
  MANUAL
}

enum ESoccerRatingSystem {
  ELO
  GLICKO
  CUSTOM
}

enum ESoccerRecommendationStatus {
  APPROVED
  OBSERVATION
  NO_BET
}

enum ESoccerMarket {
  MATCH_WINNER
  DRAW_NO_BET
  BOTH_TEAMS_TO_SCORE
  OVER_2_5
  OVER_3_5
  OVER_4_5
  OVER_5_5
}

model ESoccerPlayer {
  id                 String                      @id @default(cuid())
  nickname           String
  normalizedNickname String                      @unique
  displayName        String?
  status             ESoccerPlayerStatus         @default(ACTIVE)
  firstSeenAt        DateTime                    @default(now())
  lastSeenAt         DateTime                    @default(now())
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  aliases            ESoccerPlayerAlias[]
  ratings            ESoccerPlayerRating[]
  rollingStats       ESoccerPlayerRollingStats[]
  homeMatches        ESoccerMatch[]              @relation("ESoccerMatchHomePlayer")
  awayMatches        ESoccerMatch[]              @relation("ESoccerMatchAwayPlayer")
  headToHeadAsA      ESoccerHeadToHeadStats[]    @relation("ESoccerH2HPlayerA")
  headToHeadAsB      ESoccerHeadToHeadStats[]    @relation("ESoccerH2HPlayerB")

  @@index([status, lastSeenAt])
  @@map("esoccer_players")
}

model ESoccerPlayerAlias {
  id              String        @id @default(cuid())
  playerId        String
  alias           String
  normalizedAlias String        @unique
  source          String?
  createdAt       DateTime      @default(now())
  player          ESoccerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("esoccer_player_aliases")
}

model ESoccerLeague {
  id                  String              @id @default(cuid())
  externalId          String?
  name                String
  normalizedName      String              @unique
  provider            ESoccerProvider     @default(FIXTURE)
  gameDurationMinutes Int?
  status              ESoccerLeagueStatus @default(UNKNOWN)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  matches             ESoccerMatch[]

  @@index([externalId])
  @@index([provider, status])
  @@map("esoccer_leagues")
}

model ESoccerVirtualTeam {
  id             String         @id @default(cuid())
  name           String
  normalizedName String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  homeMatches    ESoccerMatch[] @relation("ESoccerMatchHomeVirtualTeam")
  awayMatches    ESoccerMatch[] @relation("ESoccerMatchAwayVirtualTeam")

  @@map("esoccer_virtual_teams")
}

model ESoccerMatch {
  id                String             @id @default(cuid())
  externalId        String?
  provider          ESoccerProvider    @default(FIXTURE)
  leagueId          String?
  scheduledAt       DateTime
  startedAt         DateTime?
  finishedAt        DateTime?
  status            ESoccerMatchStatus @default(SCHEDULED)
  homePlayerId      String
  awayPlayerId      String
  homeVirtualTeamId String?
  awayVirtualTeamId String?
  homeScore         Int?
  awayScore         Int?
  rawHomeName       String
  rawAwayName       String
  sourcePayload     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  league          ESoccerLeague?          @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  homePlayer      ESoccerPlayer           @relation("ESoccerMatchHomePlayer", fields: [homePlayerId], references: [id], onDelete: Restrict)
  awayPlayer      ESoccerPlayer           @relation("ESoccerMatchAwayPlayer", fields: [awayPlayerId], references: [id], onDelete: Restrict)
  homeVirtualTeam ESoccerVirtualTeam?     @relation("ESoccerMatchHomeVirtualTeam", fields: [homeVirtualTeamId], references: [id], onDelete: SetNull)
  awayVirtualTeam ESoccerVirtualTeam?     @relation("ESoccerMatchAwayVirtualTeam", fields: [awayVirtualTeamId], references: [id], onDelete: SetNull)
  predictions     ESoccerPrediction[]
  recommendations ESoccerRecommendation[]

  // Regra de domínio (não expressa como CHECK de banco nesta fase):
  // homePlayerId != awayPlayerId é validado em src/services/esoccerDomainService.ts.
  @@unique([provider, externalId])
  @@index([externalId])
  @@index([provider])
  @@index([leagueId])
  @@index([scheduledAt])
  @@index([status])
  @@index([homePlayerId])
  @@index([awayPlayerId])
  @@map("esoccer_matches")
}

model ESoccerPlayerRating {
  id           String              @id @default(cuid())
  playerId     String
  rating       Float
  ratingSystem ESoccerRatingSystem @default(CUSTOM)
  matchesCount Int                 @default(0)
  recordedAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())
  player       ESoccerPlayer       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([recordedAt])
  @@map("esoccer_player_ratings")
}

model ESoccerPlayerRollingStats {
  id                  String        @id @default(cuid())
  playerId            String
  windowSize          Int
  matchesCount        Int           @default(0)
  wins                Int           @default(0)
  draws               Int           @default(0)
  losses              Int           @default(0)
  goalsFor            Int           @default(0)
  goalsAgainst        Int           @default(0)
  avgGoalsFor         Float         @default(0)
  avgGoalsAgainst     Float         @default(0)
  bothTeamsScoredRate Float         @default(0)
  over25Rate          Float         @default(0)
  over35Rate          Float         @default(0)
  over45Rate          Float         @default(0)
  calculatedAt        DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  player              ESoccerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, windowSize])
  @@map("esoccer_player_rolling_stats")
}

model ESoccerHeadToHeadStats {
  id                  String        @id @default(cuid())
  playerAId           String
  playerBId           String
  matchesCount        Int           @default(0)
  playerAWins         Int           @default(0)
  draws               Int           @default(0)
  playerBWins         Int           @default(0)
  playerAGoals        Int           @default(0)
  playerBGoals        Int           @default(0)
  over25Rate          Float         @default(0)
  over35Rate          Float         @default(0)
  bothTeamsScoredRate Float         @default(0)
  calculatedAt        DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  playerA             ESoccerPlayer @relation("ESoccerH2HPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB             ESoccerPlayer @relation("ESoccerH2HPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  // Regra de domínio: o par deve ser canônico (playerAId < playerBId).
  // Não expresso como CHECK de banco nesta fase; ver canonicalizePlayerPair()
  // em src/lib/esoccer/normalization.ts e validação em esoccerDomainService.ts.
  @@unique([playerAId, playerBId])
  @@index([playerAId])
  @@index([playerBId])
  @@map("esoccer_head_to_head_stats")
}

model ESoccerPrediction {
  id                 String                  @id @default(cuid())
  matchId            String
  modelVersion       String
  homeWinProbability Float
  drawProbability    Float
  awayWinProbability Float
  expectedTotalGoals Float?
  over25Probability  Float?
  over35Probability  Float?
  over45Probability  Float?
  confidenceScore    Float
  createdAt          DateTime                @default(now())
  match              ESoccerMatch            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  recommendations    ESoccerRecommendation[]

  @@index([matchId])
  @@index([createdAt])
  @@map("esoccer_predictions")
}

model ESoccerRecommendation {
  id                   String                      @id @default(cuid())
  matchId              String
  predictionId         String?
  market               ESoccerMarket
  selection            String?
  status               ESoccerRecommendationStatus
  confidenceScore      Float
  estimatedProbability Float?
  offeredOdd           Float?
  impliedProbability   Float?
  edge                 Float?
  reason               String
  riskFlags            String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  match                ESoccerMatch                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  prediction           ESoccerPrediction?          @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([predictionId])
  @@index([status, market])
  @@map("esoccer_recommendations")
}

// =====================================================================
// Prediction Center Persistence — Sprint 7.2 (PREDICTION PERSISTENCE &
// LEARNING FOUNDATION)
// Persistencia do Prediction Orchestrator (Sprint 4.3+), inteiramente
// desacoplada do pipeline legado acima (ESoccerPrediction/
// ESoccerRecommendation pertencem a um motor diferente, com semantica
// diferente — nunca reaproveitados aqui, decisao da Sprint 6.5).
// Deliberadamente denormalizado (sem @relation para ESoccerMatch/
// ESoccerPlayer/ESoccerLeague/ESoccerVirtualTeam) — decisao da Sprint 7.1,
// reconfirmada nesta sprint.
// =====================================================================

enum PredictionSource {
  FIXTURE
  REAL
}

model PredictionSnapshotRecord {
  id           String   @id @default(cuid())
  snapshotHash String   @unique
  createdAt    DateTime @default(now())

  matchId         String
  homePlayerId    String
  awayPlayerId    String
  virtualTeamHome String?
  virtualTeamAway String?
  league          String?
  period          String?
  sequenceKey     String?

  modelVersion      String
  configurationHash String
  generatedAt       DateTime
  source            PredictionSource
  schemaVersion     String

  // Campos denormalizados para filtros rapidos.
  // A fonte de verdade continua sendo snapshotPayload.
  greenScoreCategory String
  combinedStatus     String

  // PredictionSnapshot completo, serializado via JSON.stringify.
  // Fonte de verdade do registro persistido.
  snapshotPayload String

  @@index([matchId])
  @@index([homePlayerId])
  @@index([awayPlayerId])
  @@index([league])
  @@index([period])
  @@index([generatedAt])
  @@map("prediction_snapshot_records")
}

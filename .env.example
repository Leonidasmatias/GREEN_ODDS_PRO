ODDS_API_KEY=
ODDS_SPORT_KEY=soccer_fifa_world_cup
ODDS_REGIONS=eu
FOOTBALL_API_KEY=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/green_odds?schema=public"
SCHEDULER_ENABLED=false
ALLOW_MOCK_PROVIDER=false

# BetsAPI real integration (Fase 3) - desativada por padrao.
# NUNCA coloque um token real neste arquivo (.env.example fica no Git).
BETSAPI_ENABLED=false
BETSAPI_MODE=fixture
BETSAPI_TOKEN=
BETSAPI_BASE_URL=https://api.b365api.com
BETSAPI_FALLBACK_BASE_URL=https://api.betsapi.com
BETSAPI_TIMEOUT_MS=10000
BETSAPI_MAX_RETRIES=3
BETSAPI_RETRY_BASE_DELAY_MS=500
BETSAPI_RATE_LIMIT_RESERVE=20
BETSAPI_SPORT_ID=1
BETSAPI_PERSIST_ENABLED=false
BETSAPI_AGGREGATION_ENABLED=false
BETSAPI_ESOCCER_ALLOWLIST=
BETSAPI_ESOCCER_DENYLIST=
BETSAPI_MAX_PAGES_PER_SYNC=3
BETSAPI_MAX_EVENTS_PER_SYNC=200

# Observabilidade e validacao em producao (Fase 3.5) - desativada por padrao.
# Nao expoe nem depende de nenhuma credencial da BetsAPI.
# CORRIGIDO apos auditoria: DataQualityEngine agora usa 6 sub-scores
# (completeness/consistency/classification/duplication/freshness/
# providerReliability), todos 0..100. OBSERVABILITY_READINESS_MIN_SCORE
# tambem passou de escala 0..1 (era 0.75) para 0..100 (75).
OBSERVABILITY_ENABLED=false
OBSERVABILITY_RETENTION_DAYS=30
OBSERVABILITY_SAMPLE_SIZE_MAX=500
OBSERVABILITY_ALERTS_ENABLED=false
OBSERVABILITY_ALERT_MIN_SEVERITY=warning
OBSERVABILITY_STORAGE_MODE=memory
OBSERVABILITY_COMPLETENESS_WEIGHT=0.25
OBSERVABILITY_CONSISTENCY_WEIGHT=0.20
OBSERVABILITY_CLASSIFICATION_WEIGHT=0.20
OBSERVABILITY_DUPLICATE_WEIGHT=0.15
OBSERVABILITY_FRESHNESS_WEIGHT=0.10
OBSERVABILITY_PROVIDER_RELIABILITY_WEIGHT=0.10
OBSERVABILITY_READINESS_MIN_SAMPLE_SIZE=30
OBSERVABILITY_READINESS_MIN_SCORE=75
OBSERVABILITY_LATENCY_P95_THRESHOLD_MS=5000
OBSERVABILITY_ERROR_RATE_THRESHOLD=0.1
OBSERVABILITY_DUPLICATE_RATE_THRESHOLD=0.05
OBSERVABILITY_STALE_DATA_MINUTES=60
